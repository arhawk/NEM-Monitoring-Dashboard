# Open Electricity API
OPEN_ELECTRICITY_API_KEY=

# MQTT broker connection
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=

# Legacy MQTT aliases, kept for compatibility with older environments
# MQTT_BROKER_HOST=127.0.0.1
# MQTT_BROKER_PORT=1883

# Topics
MQTT_SUBSCRIBE_TOPIC_FILTER=comp5339/task123/measurements/#
MQTT_PUBLISH_TOPIC_TEMPLATE=comp5339/task123/measurements/{facility_code}

# Publisher timing
PUBLISH_DURATION_SECONDS=0
FACILITY_METADATA_DATA_DIR=data/raw/facility_metadata
FETCH_DATE_START=2025-10-24T23:00:00
FETCH_DATE_END=2025-10-31T22:59:59

# Dashboard cache / refresh
MAX_STREAM_ROWS=5520
RESET_INTERVAL_HOURS=6
MAIN_REFRESH_INTERVAL_SECONDS=1
SIDEBAR_REFRESH_INTERVAL_SECONDS=1
MQTT_MONITOR_INTERVAL_SECONDS=5
STREAM_CACHE_SNAPSHOT_PATH=data/cache/stream_cache_snapshot.json
STREAM_CACHE_PERSIST_EVERY_MESSAGES=100

# GitHub Actions cloud control
ENABLE_GITHUB_ACTIONS_CONTROL=false
AUTO_START_PUBLISHER=false
AUTO_START_COOLDOWN_SECONDS=600
GITHUB_TOKEN=
GITHUB_OWNER=arhawk
GITHUB_REPO=NEM-Monitoring-Dashboard
GITHUB_WORKFLOW_FILE=publish-mqtt-on-demand.yml
GITHUB_REF=main

# LLM analytics (optional, Google AI Studio / Gemini API)
ENABLE_LLM_ANALYTICS=false
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.1-flash-lite
LLM_MAX_ROWS=5000
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_AUDIT_DIR=data/cache/llm_runs
